[Unit]
Description=Conquer Online 2.0 - AccountServer (Referencia para binarios TQ C++ separados)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=conquer
Group=conquer
WorkingDirectory=/opt/conquer/AccountServer
Environment=WINEARCH=win32
Environment=WINEPREFIX=/opt/conquer/.wine
Environment=WINEDEBUG=-all
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1024x768x16" /usr/bin/wine /opt/conquer/AccountServer/AccountServer.exe
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=conquer-account

[Install]
WantedBy=multi-user.target
