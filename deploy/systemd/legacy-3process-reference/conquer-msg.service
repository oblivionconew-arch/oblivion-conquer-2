[Unit]
Description=Conquer Online 2.0 - MsgServer (Referencia para binarios TQ C++ separados)
After=network-online.target mariadb.service conquer-account.service
Requires=conquer-account.service

[Service]
Type=simple
User=conquer
Group=conquer
WorkingDirectory=/opt/conquer/GameServer
Environment=WINEARCH=win32
Environment=WINEPREFIX=/opt/conquer/.wine
Environment=WINEDEBUG=-all
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1024x768x16" /usr/bin/wine /opt/conquer/GameServer/MsgServer.exe
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=conquer-msg

[Install]
WantedBy=multi-user.target
