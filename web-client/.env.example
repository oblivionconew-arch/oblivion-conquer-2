# Copie para .env e preencha antes de subir o docker compose
PUBLIC_STREAM_BASE_URL=https://stream.oblivionco.com.br
ALLOWED_ORIGINS=https://oblivionco.com.br,https://www.oblivionco.com.br,https://oblivionco.pages.dev,capacitor://localhost,https://localhost
JWT_SECRET=MUDE_PARA_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES

# Pasta do cliente Conquer ja limpo (FixClient.ps1) na VPS Linux
HOST_CLIENT_PATH=/opt/conquer/client

# Motor: kasmvnc (porta 6901, funciona atras da Cloudflare) ou selkies (porta 8080, WebRTC)
SESSION_IMAGE=oblivionco/conquer-web-client:latest
SESSION_ENGINE=kasmvnc
SESSION_CONTAINER_PORT=6901

# Servidor Conquer 2.0
GAME_SERVER_HOST=game.oblivionco.com.br
GAME_AUTH_PORT=9958
GAME_PORT=5816

# Limites por sessao (5 minutos de inatividade = 300000 ms)
MAX_CONCURRENT_SESSIONS=10
SESSION_MEMORY_MB=1536
SESSION_CPUS=1.0
IDLE_TIMEOUT_MS=300000

# Banco MySQL do Conquer (tabela accounts)
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=conquer
MYSQL_PASSWORD=TROQUE_ESTA_SENHA
MYSQL_DATABASE=conquer

# Supabase (opcional - se preenchido, aceita tokens JWT do Supabase Auth)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
ALLOW_GUEST_DEMO=false
