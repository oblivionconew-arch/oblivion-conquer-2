stream.oblivionco.com.br {
    encode gzip zstd

    # Download direto de instaladores e arquivos
    handle /downloads/* {
        root * /var/downloads
        uri strip_prefix /downloads
        file_server browse
    }

    # Aumenta timeouts para conexoes WebSocket/KasmVNC longas
    reverse_proxy orchestrator:3000 {
        flush_interval -1
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}