<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
      <size>
        <width>1024</width>
        <height>768</height>
      </size>
    </application>
  </applications>
</openbox_config>
